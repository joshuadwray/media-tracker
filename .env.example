# Copy to .env (or export in your shell / set as GitHub Actions secrets).
# The tracker reads plain environment variables — if you use a .env file
# locally, load it with `set -a; source .env; set +a` before running.

# ntfy.sh phone push. Install the ntfy app, subscribe to an unguessable
# topic name, and put that name here. Anyone who knows the topic can
# read/post to it on the public server, so treat it like a password.
NTFY_TOPIC=

# Optional overrides:
# NTFY_SERVER=https://ntfy.sh
# NTFY_TOKEN=

# Hermes book-finished relay: the dedicated ntfy topic the GitHub Actions
# workflow publishes book.finished payloads to and the local relay daemon
# (launchd, tracker/hermes_relay.py) streams. Unguessable like NTFY_TOPIC —
# anyone who learns it can trigger a book critique, so treat it like a
# password. Also set it as the HERMES_NTFY_TOPIC Actions secret.
HERMES_NTFY_TOPIC=

# Optional relay overrides:
# HERMES_NTFY_SERVER=https://ntfy.sh
# HERMES_WEBHOOK_URL=http://localhost:8644/webhooks/book-finished
# HERMES_WEBHOOK_SECRET=   # resolved from the local Hermes install if unset
# HERMES_NTFY_TOKEN=       # only if the topic is access-token protected
